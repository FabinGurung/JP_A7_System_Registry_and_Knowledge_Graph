      "authority_configured": true,
      "materiality": "MATERIAL",
      "timestamp_strategy": "NO_TIMESTAMP_ARBITRATION",
      "claims": [
        {
          "claim_role": "DECLARED_AUTHORITY",
          "value": 48,
          "source_ref_id": "SRC-SHEET"
        },
        {
          "claim_role": "EVIDENCE",
