{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FabinGurung/JP_A7_System_Registry_and_Knowledge_Graph/main/schemas/project-identities.schema.json",
  "title": "A7 Project Semantic Identity Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority",
    "provider_observation",
    "project_count",
    "project_identities",
    "rule",
    "retired_project_id_aliases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "ACTIVE"
    },
    "authority": {
      "type": "object"
    },
    "provider_observation": {
      "type": "object"
    },
    "project_count": {
      "type": "integer",
      "minimum": 1
    },
    "project_identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "source_record_key"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^PRJ-[0-9]{6}$"
          },
          "source_record_key": {
            "type": "string",
            "pattern": "^PRJ-[0-9]{6}$"
          }
        }
      }
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "retired_project_id_aliases": {
      "type": "array",
      "uniqueItems": true,
      "description": "Retired project IDs that redirect to an existing active canonical ID; never act as additional routable projects.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias_project_id",
          "canonical_project_id",
          "state",
          "active_project",
          "resolution",
          "provider_evidence"
        ],
        "properties": {
          "alias_project_id": {
            "type": "string",
            "pattern": "^PRJ-[0-9]{6}$"
          },
          "canonical_project_id": {
            "type": "string",
            "pattern": "^PRJ-[0-9]{6}$"
          },
          "state": {
            "const": "RETIRED_DUPLICATE_RESERVED"
          },
          "active_project": {
            "const": false
          },
          "resolution": {
            "const": "RESOLVE_TO_CANONICAL_ONLY"
          },
          "provider_evidence": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  }
}
