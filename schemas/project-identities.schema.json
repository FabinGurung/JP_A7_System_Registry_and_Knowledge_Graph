{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FabinGurung/JP_A7_System_Registry_and_Knowledge_Graph/main/schemas/project-identities.schema.json",
  "title": "A7 Project Semantic Identity Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority",
    "provider_observation",
    "project_count",
    "project_identities",
    "rule"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "ACTIVE"
    },
    "authority": {
      "type": "object"
    },
    "provider_observation": {
      "type": "object"
    },
    "project_count": {
      "type": "integer",
      "minimum": 1
    },
    "project_identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "source_record_key"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^PRJ-[0-9]{6}$"
          },
          "source_record_key": {
            "type": "string",
            "pattern": "^PRJ-[0-9]{6}$"
          }
        }
      }
    },
    "rule": {
      "type": "string",
      "minLength": 1
    }
  }
}
