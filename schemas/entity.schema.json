{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabingurung.github.io/JP_A7_System_Registry_and_Knowledge_Graph/schemas/entity.schema.json",
  "title": "A7 Entity",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "canonical_label",
    "status"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
    },
    "entity_type": {
      "type": "string",
      "minLength": 1
    },
    "canonical_label": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
