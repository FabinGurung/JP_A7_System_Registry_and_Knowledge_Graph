{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabingurung.github.io/JP_A7_System_Registry_and_Knowledge_Graph/schemas/alias.schema.json",
  "title": "A7 Alias",
  "type": "object",
  "required": [
    "alias_id",
    "target_entity_id",
    "alias",
    "alias_type",
    "active"
  ],
  "properties": {
    "alias_id": {
      "type": "string",
      "pattern": "^ALIAS-[0-9]{6}$"
    },
    "target_entity_id": {
      "type": "string",
      "minLength": 1
    },
    "alias": {
      "type": "string",
      "minLength": 1
    },
    "alias_type": {
      "type": "string",
      "minLength": 1
    },
    "active": {
      "type": "boolean"
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
