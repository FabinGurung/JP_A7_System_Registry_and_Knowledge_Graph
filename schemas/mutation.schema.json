{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabingurung.github.io/JP_A7_System_Registry_and_Knowledge_Graph/schemas/mutation.schema.json",
  "title": "A7 Mutation Event",
  "type": "object",
  "required": [
    "event_id",
    "sequence_id",
    "event_type",
    "status",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^A7-EVT-[0-9]{6}-[0-9]{3}$"
    },
    "sequence_id": {
      "type": "string",
      "pattern": "^A7-SEQ-[0-9]{6}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "pre_commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "post_commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "working_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
