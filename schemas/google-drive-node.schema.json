{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabingurung.github.io/JP_A7_System_Registry_and_Knowledge_Graph/schemas/google-drive-node.schema.json",
  "title": "A7 Google Drive Topology Node",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "canonical_label",
    "semantic_role",
    "provider",
    "parent_entity_id",
    "access_class",
    "public_safe_metadata",
    "public_projection",
    "status",
    "observed_at"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "pattern": "^GDRIVE-(ROOT|TOP|ANCHOR)-[0-9]{6}$"
    },
    "entity_type": {
      "type": "string"
    },
    "canonical_label": {
      "type": "string",
      "minLength": 1
    },
    "semantic_role": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "const": "google_drive"
    },
    "provider_object_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_object_id_redacted": {
      "type": "boolean"
    },
    "parent_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "access_class": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED",
        "UNKNOWN"
      ]
    },
    "public_safe_metadata": {
      "type": "boolean"
    },
    "public_projection": {
      "type": "boolean"
    },
    "status": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
