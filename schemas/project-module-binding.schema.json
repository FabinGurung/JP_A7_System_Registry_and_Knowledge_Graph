{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FabinGurung/JP_A7_System_Registry_and_Knowledge_Graph/main/schemas/project-module-binding.schema.json",
  "title": "A7 Project to Module Routing Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "contract_id",
    "source_project_identity_registry",
    "execution_profiles",
    "project_binding_count",
    "project_bindings",
    "resolver_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "ACTIVE"
    },
    "contract_id": {
      "const": "A7-CONTRACT-PROJECT-MODULE-ROUTING-001"
    },
    "source_project_identity_registry": {
      "const": "registry/entities/project-identities.json"
    },
    "execution_profiles": {
      "type": "array",
      "minItems": 1
    },
    "project_binding_count": {
      "type": "integer",
      "minimum": 1
    },
    "project_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "execution_profile_id",
          "binding_status",
          "project_specific_module_instances"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^PRJ-[0-9]{6}$"
          },
          "execution_profile_id": {
            "type": "string"
          },
          "binding_status": {
            "const": "ACTIVE_ROUTING"
          },
          "project_specific_module_instances": {
            "const": "NOT_ASSERTED_BY_A7"
          }
        }
      }
    },
    "resolver_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
