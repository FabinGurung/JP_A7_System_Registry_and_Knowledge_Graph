{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabingurung.github.io/JP_A7_System_Registry_and_Knowledge_Graph/schemas/project.schema.json",
  "title": "A7 Project",
  "type": "object",
  "required": [
    "project_id",
    "canonical_label",
    "status"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^(PRJ|PROJ)-[0-9]{6}$"
    },
    "canonical_label": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "company_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
