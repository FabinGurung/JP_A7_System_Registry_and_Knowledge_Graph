{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FabinGurung/JP_A7_System_Registry_and_Knowledge_Graph/main/schemas/module-manifest.schema.json",
  "title": "A7 Cross-Repository Module Routing Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_kind",
    "manifest_status",
    "module_id",
    "repository_id",
    "provider_repository_id",
    "repository_full_name",
    "canonical_label",
    "module_role",
    "ownership_profile_id",
    "a7_registry",
    "refs",
    "routing_entrypoints",
    "resolver_rules",
    "manifest_role",
    "observed_at"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_kind": {
      "const": "A7_MODULE_MANIFEST"
    },
    "manifest_status": {
      "const": "ACTIVE"
    },
    "module_id": {
      "type": "string",
      "pattern": "^MOD-[A-Z]+-[0-9]{3}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^REPO-[0-9]{6}$"
    },
    "provider_repository_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "repository_full_name": {
      "type": "string",
      "minLength": 3
    },
    "canonical_label": {
      "type": "string",
      "minLength": 1
    },
    "module_role": {
      "type": "string",
      "minLength": 1
    },
    "ownership_profile_id": {
      "type": "string",
      "pattern": "^OWN-MOD-[A-Z]+-[0-9]{3}$"
    },
    "a7_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "repository_id",
        "provider_repository_id",
        "repository_full_name",
        "module_registry_path",
        "ownership_registry_path",
        "authority_map_path",
        "system_boundary_path"
      ],
      "properties": {
        "system_id": {
          "const": "SYS-A7-000001"
        },
        "repository_id": {
          "const": "REPO-000001"
        },
        "provider_repository_id": {
          "const": "1406572237"
        },
        "repository_full_name": {
          "const": "FabinGurung/JP_A7_System_Registry_and_Knowledge_Graph"
        },
        "module_registry_path": {
          "const": "registry/entities/modules.json"
        },
        "ownership_registry_path": {
          "const": "registry/authority/module-ownership.json"
        },
        "authority_map_path": {
          "const": "registry/authority/authority-map.json"
        },
        "system_boundary_path": {
          "const": "registry/authority/system-boundaries.json"
        }
      }
    },
    "refs": {
      "type": "object",
      "required": [
        "default_branch",
        "canonical_working_ref"
      ],
      "properties": {
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "canonical_working_ref": {
          "type": "string",
          "minLength": 1
        },
        "publication_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "development_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "routing_entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entrypoint_id",
          "kind",
          "ref",
          "path"
        ],
        "properties": {
          "entrypoint_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resolver_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manifest_role": {
      "const": "ROUTING_ONLY_NON_AUTHORITATIVE_FOR_DOMAIN_FACTS"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
