{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabingurung.github.io/JP_A7_System_Registry_and_Knowledge_Graph/schemas/repository-role-candidate.schema.json",
  "title": "A7 Repository Role Candidate",
  "type": "object",
  "required": [
    "role_candidate_id",
    "repository_id",
    "candidate_role",
    "confidence",
    "binding_status",
    "evidence",
    "observed_at"
  ],
  "properties": {
    "role_candidate_id": {
      "type": "string"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^REPO-[0-9]{6}$"
    },
    "candidate_role": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "binding_status": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
