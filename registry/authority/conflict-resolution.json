{
  "schema_version": "1.0.0",
  "engine_id": "A7-AUTHORITY-RESOLVER-001",
  "status": "ACTIVE",
  "principle": "AUTHORITY_BEFORE_RECENCY",
  "scope_precedence": [
    "ENTITY_OVERRIDE",
    "PROJECT_OVERRIDE",
    "MODULE_OVERRIDE",
    "GLOBAL_FACT_CLASS"
  ],
  "algorithm": [
    "RESOLVE_ENTITY_AND_FACT_CLASS",
    "LOAD_MOST_SPECIFIC_APPLICABLE_AUTHORITY_RULE",
    "LOAD_PROVIDER_POLICY_AND_PUBLIC_SAFETY_POLICY",
    "FETCH_LIVE_PROVIDER_IF_CURRENT_STATE_IS_REQUIRED",
    "CLASSIFY_CLAIMS_AS_DECLARED_AUTHORITY_VERIFIED_HUMAN_QA_EVIDENCE_PROJECTION_OR_UNKNOWN",
    "VALIDATE_SOURCE_REFERENCES_AND_SCHEMA",
    "IF_VERIFIED_HUMAN_QA_RESOLUTION_MATCHES_OPEN_CASE_USE_ONLY_WITHIN_CASE_SCOPE",
    "IF_NO_AUTHORITY_IS_CONFIGURED_BLOCK_MUTATION",
    "IF_ONE_AUTHORITY_VALUE_EXISTS_USE_IT",
    "IF_MULTIPLE_AUTHORITY_VALUES_DIFFER_DO_NOT_GUESS",
    "APPLY_TIMESTAMP_ARBITRATION_ONLY_WHEN_FACT_CLASS_EXPLICITLY_PERMITS_IT",
    "IF_MATERIAL_EVIDENCE_CONTRADICTS_AUTHORITY_KEEP_AUTHORITY_AND_OPEN_HUMAN_QA_RECONCILIATION",
    "IF_PROJECTION_DIFFERS_FROM_AUTHORITY_REGENERATE_PROJECTION",
    "IF_PROVIDER_FAILS_THREE_TIMES_DEFER_BLOCKED_DEPENDENCY_AND_CONTINUE_INDEPENDENT_WORK",
    "PUBLIC_SAFETY_GATE_BEFORE_PUBLIC_PROJECTION",
    "MUTATE_ONLY_DECLARED_WRITABLE_AUTHORITY",
    "APPEND_A7_MUTATION_AND_SOURCE_REFERENCES",
    "REGENERATE_DERIVED_VIEWS_AND_PROVIDER_READBACK"
  ],
  "hard_rules": {
    "newest_wins_by_default": false,
    "AI_may_invent_missing_authority": false,
    "projection_may_override_authority": false,
    "evidence_may_silently_override_authority": false,
    "unresolved_material_conflict_requires_human_qa": true,
    "safety_critical_conflict_requires_human_qa": true,
    "provider_failure_attempt_limit": 3
  }
}
